    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Integer" array="False" size=""/>
            <assign variable="numero" expression="1"/>
            <while expression="numero &lt;= 10">
                <output expression="&quot;il valore della variabile numero &#232;: &quot; &amp;numero" newline="True"/>
                <assign variable="numero" expression="numero + 1"/>
            </while>
        </body>
    </function>
