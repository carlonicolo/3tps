    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="primonumero" type="Integer" array="False" size=""/>
            <declare name="secondonumero" type="Integer" array="False" size=""/>
            <declare name="somma" type="Integer" array="False" size=""/>
            <assign variable="primonumero" expression="5"/>
            <assign variable="secondonumero" expression="10"/>
            <assign variable="somma" expression="primonumero + secondonumero"/>
            <output expression="&quot;La somma del numero &quot; &amp;primonumero&amp; &quot; + &quot; &amp;secondonumero&amp; &quot; = &quot; &amp;somma" newline="True"/>
        </body>
    </function>
