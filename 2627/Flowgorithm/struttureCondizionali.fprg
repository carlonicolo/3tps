<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Karlitos"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-25 11:16:09 "/>
        <attribute name="created" value="S2FybGl0b3M7REVTS1RPUC1CN0VPQkw4OzIwMjYtMDktMjU7IjEwOjI1OjA4ICI7MzA4OA=="/>
        <attribute name="edited" value="S2FybGl0b3M7REVTS1RPUC1CN0VPQkw4OzIwMjYtMDktMjU7IjExOjE2OjA5ICI7NjszMjAz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="eta" type="Integer" array="False" size=""/>
            <output expression="&quot;Quanti anni hai ? &quot;" newline="True"/>
            <input variable="eta"/>
            <if expression="eta &gt;= 18">
                <then>
                    <output expression="&quot;Sei maggiorenne&quot;" newline="True"/>
                    <if expression="eta &lt;= 23">
                        <then>
                            <output expression="&quot;Puoi guidare macchine fino a 80cv&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Non hai limiti di cavalli fiscali&quot;" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;Sei minorenne&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
